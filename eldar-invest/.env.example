# ELDAR INVEST — Firebase configuration (optional)
# Leave empty to run fully offline with the built-in local demo backend.
# When all values are set, authentication and user data are stored in Firebase
# (Firebase Authentication + Cloud Firestore) instead of the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# ELDAR AI — SERVER-ONLY secrets (no VITE_ prefix: never sent to the browser)
# Set these in your hosting provider's environment settings, not in code.
# Without them ELDAR AI still works with the built-in analyst on demo data.
# ---------------------------------------------------------------------------

# Google Gemini (https://aistudio.google.com/apikey). Free tier has per-model
# request/day limits shown in AI Studio; it is not unlimited.
GEMINI_API_KEY=
# Optional: pin a model. By default the server asks the API which models the
# key can use and picks the newest stable Flash model.
GEMINI_MODEL=

# Finnhub (https://finnhub.io): quotes, company profiles, metrics, news,
# earnings calendar. Free plan ~60 calls/min, personal use.
FINNHUB_API_KEY=

# Twelve Data (https://twelvedata.com): price history for charts/forecasts.
# Free plan 8 requests/min, 800/day, personal non-display use.
TWELVEDATA_API_KEY=

# SEC EDGAR needs no key. SEC asks you to identify your app with contact
# details, e.g. "ELDAR INVEST admin@your-domain.com". Set SEC_EDGAR=off to disable.
SEC_USER_AGENT=
SEC_EDGAR=

# Optional per-visitor limits for the AI endpoint (defaults: 12/min, 300/day).
AI_RATE_PER_MINUTE=
AI_RATE_PER_DAY=

# Optional: when the frontend is hosted separately from the API.
VITE_API_BASE=
