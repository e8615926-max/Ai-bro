# ELDAR INVEST — Firebase configuration (optional)
# Leave empty to run fully offline with the built-in local demo backend.
# When all values are set, authentication and user data are stored in Firebase
# (Firebase Authentication + Cloud Firestore) instead of the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
